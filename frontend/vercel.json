{
  "rewrites": [
    { "source": "/((?!assets|favicon\\.ico|robots\\.txt|manifest\\.json|sw\\.js|logo.*\\.png).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
